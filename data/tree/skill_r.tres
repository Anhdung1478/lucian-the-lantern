[gd_resource type="Resource" script_class="TreeNodeData" format=3]

[ext_resource type="Script" path="res://src/core/tree_node_data.gd" id="1_data"]
[ext_resource type="Texture2D" path="res://assets/art/tree/skill_r.svg" id="2_icon"]

[resource]
script = ExtResource("1_data")
id = &"skill_r"
display_name = "R – The Culling"
description = "Buys ranks of R. In a stage, skill points only go into bought ranks. Needs Q, W, E and the passive."
icon = ExtResource("2_icon")
branch = &"skills"
grid = Vector2(2, 2)
max_level = 3
blue = Array[int]([600, 1200, 2000])
orange = Array[int]([10, 20, 30])
requires = Array[StringName]([&"skill_q", &"skill_w", &"skill_e", &"passive"])
per_level = 1.0
format = "Rank {v}"
