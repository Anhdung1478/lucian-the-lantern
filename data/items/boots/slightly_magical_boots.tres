[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://src/core/item_effect.gd" id="1_effect"]
[ext_resource type="Texture2D" path="res://assets/art/items/slightly_magical_boots.svg" id="2_icon"]
[ext_resource type="Script" path="res://src/core/item_data.gd" id="3_data"]

[sub_resource type="Resource" id="Resource_slightly_quicker"]
script = ExtResource("1_effect")
effect_name = "Slightly Quicker"
description = "+10 [ms]move speed[/ms]. Every boot upgraded from these keeps it."

[resource]
script = ExtResource("3_data")
id = &"slightly_magical_boots"
display_name = "Slightly Magical Boots"
kind = 3
code = "SM"
icon = ExtResource("2_icon")
stats = Dictionary[StringName, float]({
&"move_speed": 25.0
})
effects = Array[ExtResource("1_effect")]([SubResource("Resource_slightly_quicker")])
boots_tier = 1
