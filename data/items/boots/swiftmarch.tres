[sub_resource type="Resource" id="Resource_noxian_fervor"]
script = ExtResource("1_effect")
effect_name = "Noxian Fervor"
description = "Gain adaptive force equal to 5% of [ms]move speed[/ms]: [ad]0.6 AD[/ad] per point, or [ap]1 AP[/ap] when bonus AP is higher than bonus AD."

[resource]
script = ExtResource("3_data")
id = &"swiftmarch"
