kind = 3
code = "SW"
icon = ExtResource("2_icon")
stats = Dictionary[StringName, float]({
&"move_speed": 65.0,
&"slow_resist": 0.25
})
effects = Array[ExtResource("1_effect")]([SubResource("Resource_noxian_fervor")])
