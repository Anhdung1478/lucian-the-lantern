#. journey.gd: Act 1's name (shown as 'Act 1 · The Loss')
msgid "The Loss"
msgstr "Mất Mát"

#. journey.gd: Act 1's story line
msgid "Lucian and Senna fight together, until Thresh takes her soul."
msgstr "Lucian và Senna chiến đấu bên nhau, cho đến khi Thresh đoạt lấy linh hồn cô."

#. journey.gd: Act 2's name
msgid "The Sentinels"
msgstr "Các Vệ Binh"

#. journey.gd: Act 2's story line
msgid "Lucian trains with Akshan to prove he's ready to hunt Thresh."
msgstr "Lucian luyện tập cùng Akshan để chứng tỏ anh đã sẵn sàng săn Thresh."

#. journey.gd: Act 3's name; also an Endless map would read Jungle
msgid "The Jungle"
msgstr "Khu Rừng"

#. journey.gd: Act 3's story line
msgid "Lucian crosses the jungle, facing the drakes and the Elder Dragon."
msgstr "Lucian băng qua khu rừng, đối đầu các rồng và Rồng Ngàn Tuổi."

#. journey.gd: Act 4's name
msgid "The Darkness"
msgstr "Bóng Tối"

#. journey.gd: Act 4's story line
msgid "Lucian faces his own fear and grief as Dark Lucian."
msgstr "Lucian đối mặt với nỗi sợ và nỗi đau của chính mình, hiện hình thành Lucian Hắc Ám."

#. journey.gd: Act 5's name
msgid "Shadow Isles"
msgstr "Quần Đảo Bóng Đêm"

#. journey.gd: Act 5's story line
msgid "Lucian fights through Maokai, Elise and Karthus."
msgstr "Lucian lần lượt vượt qua Maokai, Elise và Karthus."

#. journey.gd: Act 6's name
msgid "The Lantern"
msgstr "Lồng Đèn"

#. journey.gd: Act 6's story line
msgid "Lucian defeats Thresh and frees Senna."
msgstr "Lucian đánh bại Thresh và giải thoát Senna."

